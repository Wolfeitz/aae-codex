{
  "description": "Route native Codex file-edit events into portable AAE event rules.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "aae-codex hook",
            "timeout": 30,
            "statusMessage": "Applying AAE event rules"
          }
        ]
      }
    ]
  }
}
